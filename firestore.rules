rules_version = '2';

// Reglas de seguridad de Golazo English.
// Cada chico solo puede leer y escribir su propio progreso.
// El administrador (usuario "eric") puede ver a todos los jugadores y publicar unidades nuevas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'eric@golazo-english.app';
    }

    // Progreso de cada jugador: players/{uid}
    match /players/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.state is string
        && request.resource.data.state.size() < 500000;
      allow delete: if isAdmin();
    }

    // Unidades nuevas del colegio: config/units (todos leen, solo el administrador escribe)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ligas de amigos: leagues/{codigo}. Se entra sabiendo el código (no se pueden listar).
    match /leagues/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
      allow update, delete: if signedIn() && (resource.data.owner == request.auth.uid || isAdmin());

      // Puntos de cada jugador en la liga: cada uno escribe solo su propia fila.
      match /members/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/leagues/$(code));
        allow delete: if signedIn() && (request.auth.uid == uid
          || get(/databases/$(database)/documents/leagues/$(code)).data.owner == request.auth.uid);
      }
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
